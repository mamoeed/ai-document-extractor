# Copy to .env and fill in DEEPINFRA_API_KEY:  cp .env.example .env
# Comments must be on their own line (no inline comments after values).

# --- LLM / VLM (DeepInfra, OpenAI-compatible) ---
DEEPINFRA_API_KEY=changeme
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
# Any DeepInfra model with image input
VLM_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct
VLM_TEMPERATURE=0
VLM_MAX_TOKENS=4096
VLM_TIMEOUT_S=120
VLM_MAX_RETRIES=2

# --- Extraction tuning ---
PDF_MIN_TEXT_CHARS_PER_PAGE=50
PDF_RENDER_DPI=200
MAX_PDF_PAGES=5
IMAGE_MAX_EDGE_PX=2000
MAX_TEXT_CHARS=60000
CONFIDENCE_THRESHOLD=0.8
SANITY_CHECKS_MODE=mock

# --- Master data (paths inside backend container) ---
CUSTOMER_MASTER_PATH=/data/master/fictional_customer_master.xlsx
ITEM_MASTER_PATH=/data/master/fictional_item_master.xlsx

# --- App ---
APP_USERNAME=admin
APP_PASSWORD=admin123
JWT_SECRET=change-this-long-random-string
JWT_EXPIRE_MINUTES=480
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20

# --- Debug / logging ---
# DEBUG=true: DEBUG-level logs, and error responses/rows include exception type + traceback
# (shown in the UI). Set DEBUG=false for any shared or production deployment.
DEBUG=true
# Optional override; defaults to DEBUG when DEBUG=true, otherwise INFO
LOG_LEVEL=

# --- Database ---
POSTGRES_USER=po
POSTGRES_PASSWORD=po
POSTGRES_DB=po
DATABASE_URL=postgresql+psycopg://po:po@db:5432/po
